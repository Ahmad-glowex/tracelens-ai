# TraceLens AI - Serverless Environment Variables
# Configure in your local .env.local or in Vercel Project Settings

# Primary Engine: River AI GLM-5.3 Flash ($25 Credit Pool active by default)
RIVER_API_KEY=
RIVER_BASE_URL=https://api.river.ai/v1
RIVER_MODEL=zai-org/GLM-5.3-Flash

# Fallback 1: Groq API Key (Free from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback 2: Google Gemini API Key (Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional BYOK Providers
OPENROUTER_API_KEY=
OPENAI_API_KEY=
