# TraceLens AI - Serverless Environment Variables
# Configure in your local .env.local or in Vercel Project Settings

# Groq API Key (Free from https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini API Key (Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: OpenRouter or OpenAI keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=
